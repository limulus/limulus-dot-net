{
  "compilerOptions": {
    // @limulus/lemmon-shell is a file: link to the lemmon checkout, whose `source`
    // export is its `src/`: typechecking against that, as `node --conditions=source`
    // runs it, needs no `npm run build` there first.
    "customConditions": ["source"],
    "esModuleInterop": true,
    "erasableSyntaxOnly": true,
    "forceConsistentCasingInFileNames": true,
    "importHelpers": true,
    "isolatedModules": true,
    "jsx": "react",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "outDir": "./dist/esm",
    "preserveWatchOutput": true,
    "rewriteRelativeImportExtensions": true,
    "rootDir": "./",
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": true,
    "target": "ES2023",
    "verbatimModuleSyntax": true
  },
  "include": [
    "*.ts",
    "./11ty/",
    "./bin/",
    "./www/**/*.ts",
    "./infra/**/*.ts",
    "./types/**/*.ts"
  ]
}
