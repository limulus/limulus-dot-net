<lem-let chronology>
  <lem-if site.tilPosts.length() gt 0>
    <lem.articleList(site.tilPosts)>
  <lem-else />
    <p>No TILs yet.</p>
  </lem-if>
</lem-let>
<h1><lem.page.title></h1>

<p>Short notes on interesting things I learn day to day.</p>

<h2>By Topic</h2>

<lem-if site.tilTopics.length() gt 0>
  <lem-let topics>
    <lem-for topic in site.tilTopics>
      <li>
        <lem.tilChip(topic, false)>
      </li>
    </lem-for>
  </lem-let>
  <lem.chipList(null, null, topics)>
<lem-else />
  <p>No topics yet.</p>
</lem-if>

