<lem-fn articleVod(vod: Vod)>
  <article-vod class="articleVod">
    <video-on-demand vod="<lem.vod.id>">
      <img async crossorigin="anonymous" loading="lazy" decoding="async"
        src="https://vod.limulus.net/<lem.vod.id>/poster.jpeg"
        width="1280" height="720" alt="<lem.vod.alt>"
        onload="this.classList.add('loadingAnimation')">
      <noscript>
        <p>Enable JavaScript to Watch</p>
      </noscript>
    </video-on-demand>
  </article-vod>
</lem-fn>
