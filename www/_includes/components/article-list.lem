<lem-fn articleList(posts: [Post])>
  <article-list class="articleList">
    <ul>
      <lem-for post in posts>
        <li>
          <lem.articleCard(post)>
        </li>
      </lem-for>
    </ul>
  </article-list>
  <lem-style>
    .articleList {
      & > ul {
        display: flex;
        flex-direction: column;
        align-items: center;
        list-style: none;
        margin: 0;
        width: 100%;
        padding: 0;
      }

      & > ul > li {
        max-width: 45rem;
        width: 100%;
      }

      & > ul > li + li {
        margin-top: 1rem;
      }
    }
  </lem-style>
</lem-fn>
