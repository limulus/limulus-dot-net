<lem-fn articlePhoto(photo: Photo, placement: Placement)>
  <lem-let linked = photo.tags.contains("limulus.net/photos") />
  <lem-let picture = phoPicture(photo, ["lg", "md"], photo.description, null) />
  <article-photo class="articlePhoto" placement="<lem.placement>">
    <figure>
      <a<lem-if linked> href="/photos/<lem.photo.alias>/"</lem-if>><lem.picture></a>
      <figcaption>
        <span><lem.photo.title></span>
      </figcaption>
    </figure>
  </article-photo>
  <lem-style>
    .articlePhoto {
      & img {
        display: block;
        margin-left: calc(var(--body-padding) * -1);
        max-width: 100vw;
        width: calc(100% + var(--body-padding) * 2);
        height: auto;
        max-height: calc(100vh - 4rem);
        object-fit: contain;
      }

      @media (min-width: 600px) {
        &[placement='right'] img,
        &[placement='right'] figcaption {
          display: block;
          float: right;
          clear: both;
          width: calc(55% + var(--body-padding) / 2);
          margin-left: 1.5rem;
          margin-right: calc(var(--body-padding) / -2);
        }

        &[placement='left'] img,
        &[placement='left'] figcaption {
          display: block;
          float: left;
          clear: both;
          width: calc(55% + var(--body-padding) / 2);
          margin-left: calc(var(--body-padding) / -2);
          margin-right: 1.5rem;
        }

        &[placement='left'] figcaption,
        &[placement='right'] figcaption {
          padding-right: 1rem;
        }
      }

      & figcaption {
        box-sizing: border-box;
        margin: 0.5rem 0;
        font-size: 0.9rem;
        text-align: right;
        --var-font-wght: 400;
        --var-font-slnt: -5;
        font-synthesis: none;
      }
    }
  </lem-style>
</lem-fn>
