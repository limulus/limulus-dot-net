<lem-fn dataChip(icon: string?, slot: html)>
  <data-chip class="dataChip">
    <lem-if icon>
      <lem.svgUse(icon)>
    </lem-if>
    <lem.slot>
  </data-chip>
  <lem-style>
    .dataChip {
      & {
        display: flex;
        align-items: center;
        flex-wrap: nowrap;
        gap: 0.5em;
        padding: 0.15em 0.7em;
        border: none;
        background-color: var(--chip-background-color);
        border-radius: 1.5em;
      }

      & svg {
        width: 1.2em;
        height: 1.2em;
        fill: var(--color);
        flex-shrink: 0;
      }

      & picture {
        display: flex;
        flex-shrink: 0;
      }

      & img {
        margin: 0 -0.1em 0 -0.1em;
        width: 1.2em;
        height: 1.2em;
        object-fit: cover;
        border-radius: 0.4em;
        border: 0.12em solid var(--color);
        overflow: hidden;
        filter: grayscale(100%);
      }
    }
  </lem-style>
</lem-fn>
