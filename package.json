{
  "name": "@limulus/limulus-dot-net",
  "version": "1.0.0",
  "description": "limulus.net",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "prebuild": "npm run clean",
    "build": "lem build",
    "cdkc": "./infra/test/cdk-synthesis.sh",
    "clean": "del-cli *.tsbuildinfo coverage dist/www dist/infra",
    "predev": "npm run prebuild",
    "dev": "concurrently -k -n css,lem \"chokidar 'www/_includes/css/*.css' -c 'npm run css'\" \"lem dev\"",
    "update-revisions": "node bin/update-revisions.ts",
    "lint": "eslint *.ts bin lemmon www infra",
    "prepare": "husky && mkdirp photos",
    "photos": "node ./bin/process-photos.js photos/* && npm run lemmon:photos",
    "lemmon:photos": "node bin/lemmon-photos.ts",
    "css": "node bin/lemmon-css.ts",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration --reporter=verbose",
    "test:all": "vitest run",
    "tscc": "tsc --noEmit",
    "verify": "concurrently -m 100% -c auto npm:lint npm:tscc npm:wwwc npm:cdkc npm:test",
    "wwwc": "lem check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/limulus/limulus-dot-net.git"
  },
  "author": {
    "name": "Eric McCarthy",
    "email": "eric@limulus.net",
    "url": "https://limulus.net/"
  },
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/limulus/limulus-dot-net/issues"
  },
  "homepage": "https://github.com/limulus/limulus-dot-net#readme",
  "dependencies": {
    "@aws-solutions-constructs/aws-cloudfront-s3": "^2.90.2",
    "@limulus/eslint-config": "^5.0.0",
    "@limulus/penumbra": "^1.9.1",
    "@matthewbonig/cdk-logical-id-mapper": "^0.0.2",
    "@prettier/plugin-xml": "^3.4.1",
    "@sindresorhus/slugify": "^2.2.1",
    "@types/node": "^20.0.0",
    "aws-rum-web": "^1.19.0",
    "basic-ftp": "^5.0.5",
    "blurhash": "^2.0.5",
    "chokidar-cli": "^3.0.0",
    "concurrently": "^8.2.2",
    "date-fns": "^4.1.0",
    "del-cli": "^5.1.0",
    "es-main": "^1.3.0",
    "eslint": "^8.57.0",
    "exifreader": "^4.25.0",
    "hls.js": "^1.6.8",
    "into-stream": "^8.0.1",
    "listr": "^0.14.3",
    "mapbox-gl": "^3.9.4",
    "media-chrome": "^4.12.0",
    "media-tracks": "^0.3.3",
    "mkdirp": "^3.0.1",
    "p-filter": "^4.1.0",
    "prettier": "^3.3.3",
    "pretty-bytes": "^6.1.1",
    "raf": "^3.4.1",
    "sharp": "^0.33.5",
    "svg-sprite": "2.0.4",
    "touch-pad": "^1.1.0",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@aws-sdk/client-cloudfront": "^3.859.0",
    "@limulus/lemmon-shell": "file:../lemmon/packages/shell",
    "@types/aws-cloudfront-function": "^1.0.5",
    "@types/raf": "^3.4.3",
    "@types/svg-sprite": "^0.0.39",
    "aws-cdk": "^2.1023.0",
    "aws-cdk-lib": "^2.208.0",
    "cdk-nag": "^2.36.50",
    "constructs": "^10.4.2",
    "dotenv": "^16.4.7",
    "globby": "^14.0.1",
    "gray-matter": "^4.0.3",
    "husky": "^9.1.5",
    "vitest": "^3.2.4"
  }
}
